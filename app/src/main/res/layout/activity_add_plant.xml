<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_page">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="22dp"
      android:paddingEnd="22dp"
      android:paddingTop="16dp"
      android:paddingBottom="28dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">
      <TextView
          android:id="@+id/buttonBack"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:gravity="center"
          android:text="←"
          android:textSize="28sp"
          android:textColor="@color/forest"
          android:clickable="true"
          android:focusable="true"
          android:contentDescription="Go back"
          android:onClick="goBack"/>
      <TextView
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_height="wrap_content"
          android:text="Add plant"
          android:textSize="22sp"
          android:textStyle="bold"
          android:textColor="@color/ink"
          android:layout_marginStart="8dp"/>
      <TextView
          android:layout_width="42dp"
          android:layout_height="42dp"
          android:gravity="center"
          android:text="☘"
          android:textSize="21sp"
          android:textColor="@color/leaf"/>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tell us about your plant"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:layout_marginBottom="14dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:paddingStart="17dp"
        android:paddingEnd="17dp"
        android:paddingTop="8dp"
        android:paddingBottom="17dp">
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="Plant name"
          android:textColor="@color/ink"
          android:textSize="13sp"
          android:textStyle="bold"
          android:layout_marginTop="11dp"
          android:layout_marginBottom="5dp"/>
      <EditText
          android:id="@+id/editName"
          android:layout_width="match_parent"
          android:layout_height="46dp"
          android:paddingStart="13dp"
          android:paddingEnd="13dp"
          android:paddingTop="8dp"
          android:paddingBottom="8dp"
          android:background="@drawable/bg_input"
          android:hint="e.g. Rose"
          android:textColor="@color/ink"
          android:textColorHint="@color/muted"
          android:textSize="14sp"
          android:inputType="text"
          android:gravity="center_vertical"
          android:singleLine="true"/>
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="Plant type"
          android:textColor="@color/ink"
          android:textSize="13sp"
          android:textStyle="bold"
          android:layout_marginTop="11dp"
          android:layout_marginBottom="5dp"/>
      <EditText
          android:id="@+id/editType"
          android:layout_width="match_parent"
          android:layout_height="46dp"
          android:paddingStart="13dp"
          android:paddingEnd="13dp"
          android:paddingTop="8dp"
          android:paddingBottom="8dp"
          android:background="@drawable/bg_input"
          android:hint="e.g. Flower or herb"
          android:textColor="@color/ink"
          android:textColorHint="@color/muted"
          android:textSize="14sp"
          android:inputType="text"
          android:gravity="center_vertical"
          android:singleLine="true"/>
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="Water every (days)"
          android:textColor="@color/ink"
          android:textSize="13sp"
          android:textStyle="bold"
          android:layout_marginTop="11dp"
          android:layout_marginBottom="5dp"/>
      <EditText
          android:id="@+id/editDays"
          android:layout_width="match_parent"
          android:layout_height="46dp"
          android:paddingStart="13dp"
          android:paddingEnd="13dp"
          android:paddingTop="8dp"
          android:paddingBottom="8dp"
          android:background="@drawable/bg_input"
          android:hint="e.g. 3"
          android:textColor="@color/ink"
          android:textColorHint="@color/muted"
          android:textSize="14sp"
          android:inputType="number"
          android:gravity="center_vertical"
          android:singleLine="true"/>
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="Notes (optional)"
          android:textColor="@color/ink"
          android:textSize="13sp"
          android:textStyle="bold"
          android:layout_marginTop="11dp"
          android:layout_marginBottom="5dp"/>
      <EditText
          android:id="@+id/editNotes"
          android:layout_width="match_parent"
          android:layout_height="70dp"
          android:paddingStart="13dp"
          android:paddingEnd="13dp"
          android:paddingTop="8dp"
          android:paddingBottom="8dp"
          android:background="@drawable/bg_input"
          android:hint="Care instructions"
          android:textColor="@color/ink"
          android:textColorHint="@color/muted"
          android:textSize="14sp"
          android:inputType="textMultiLine"
          android:gravity="top"/>
    </LinearLayout>
    <Button
        android:id="@+id/buttonSave"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:text="Save plant  ✓"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"/>
  </LinearLayout>
</ScrollView>
