<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:background="@drawable/bg_page">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="52dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:layout_marginBottom="20dp">
    <TextView
        android:id="@+id/buttonBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="←"
        android:textSize="28sp"
        android:textColor="@color/forest"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Go back"
        android:onClick="goBack"/>
    <TextView
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="Watering schedule"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/ink"
        android:layout_marginStart="8dp"/>
    <TextView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:gravity="center"
        android:text="☘"
        android:textSize="21sp"
        android:textColor="@color/leaf"/>
  </LinearLayout>
  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Plants that need water today"
      android:textColor="@color/muted"
      android:textSize="14sp"
      android:layout_marginBottom="18dp"/>
  <TextView
      android:id="@+id/textDueEmpty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@drawable/bg_card"
      android:padding="24dp"
      android:text="All caught up! Nothing needs watering today."
      android:gravity="center"
      android:textColor="@color/leaf"
      android:textSize="15sp"/>
  <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/recyclerDue"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:paddingBottom="12dp"/>
</LinearLayout>
